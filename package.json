{
  "name": "intent-os",
  "version": "0.4.4-alpha",
  "description": "Intent OS — Cognitive Operating System",
  "main": "dist/server.cjs",
  "scripts": {
    "build": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild gateway/adapter.ts gateway/transport.ts --outdir=dist/gateway --format=esm",
    "dev": "npm run build && node dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "test": "node --test tests/test_gateway.js",
    "test:python": "python3 -m unittest discover tests"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "esbuild": "^0.20.2",
    "typescript": "^5.4.5"
  }
}
